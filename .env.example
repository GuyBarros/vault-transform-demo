# ── Vault ──────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root                    # dev mode only — use AppRole em produção
VAULT_ROLE_ID=                      # preenchido pelo setup_vault.sh
VAULT_SECRET_ID=                    # preenchido pelo setup_vault.sh
VAULT_NAMESPACE=                    # namespace Enterprise (vazio = root)
VAULT_TRANSFORM_MOUNT=transform     # mount path do Transform Engine

# ── Banco de Dados ─────────────────────────────────────────────────────────────
DB_URL=postgresql://vault_demo:vault_demo@localhost:5432/vault_demo

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ROLE=api-role                   # Transform role para APIs de produção
CORE_ROLE=core-role                 # Transform role para sistemas core (decode)

# ── Pipeline ───────────────────────────────────────────────────────────────────
PIPELINE_ROLE=pipeline-role
PIPELINE_BATCH_SIZE=100             # itens por batch_input call
